logger:
  file:
    path: /var/log/open5gs/smf.log

global:

smf:
  sbi:
    server:
      - address: smf{{ slice.index }}.open5gs.org
        port: 80
    client:
      nrf:
        - uri: http://nrf.open5gs.org:80
  pfcp:
    server:
      - address: smf{{ slice.index }}.open5gs.org
    client:
      upf:
        - address: upf{{ slice.index }}.open5gs.org
  metrics:
    server:
      - address: smf{{ slice.index }}.open5gs.org
        port: 9090
  gtpu:
    server:
      - address: smf{{ slice.index }}.open5gs.org
  session:
    - subnet: {{ slice.upf_subnet }}
      gateway: {{ slice.upf_gateway }}
  dns:
    - 8.8.8.8
    - 8.8.4.4
  mtu: 1400
  info:
    - s_nssai:
      - sst: {{ slice.sst }}
        sd: {{ slice.sd_hex }}
        dnn:
          - internet
      tai:
        - plmn_id:
            mcc: 001
            mnc: 01
          tac: 1
