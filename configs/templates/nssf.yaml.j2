logger:
  file:
    path: /var/log/open5gs/nssf.log

global:

nssf:
  sbi:
    server:
      - address: nssf.open5gs.org
        port: 80
    client:
      nrf:
        - uri: http://nrf.open5gs.org:80
      nsi:
{% for slice in slices %}
        - uri: http://nrf.open5gs.org:80
          s_nssai:
            sst: {{ slice.sst }}
            sd: {{ slice.sd_hex }}
{% endfor %}
